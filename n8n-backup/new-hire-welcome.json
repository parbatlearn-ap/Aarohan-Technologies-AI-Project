        },
        "start": "={{ $now.plus(1, 'days').set({ hour: 10, minute: 0, second: 0 }).toISO() }}",
        "end": "={{ $now.plus(1, 'days').set({ hour: 11, minute: 0, second: 0 }).toISO() }}",
        "additionalFields": {
          "summary": "=Onboarding Orientation - {{ $('Prepare Employee Context').item.json.employee_name }}",
          "description": "=Welcome orientation session for {{ $('Prepare Employee Context').item.json.employee_name }} (Aarohan Technologies). Virtual onboarding session — join link to be shared by People Ops.",
          "attendees": [
            "={{ $('Prepare Employee Context').item.json.email }}"
          ]
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "",
          "name": "REPLACE_ME - Google Calendar OAuth2"
        }
      }
    },
    {
      "id": "build-result---virtual",
      "name": "Build Result - Virtual",
      "type": "n8n-nodes-base.code",
