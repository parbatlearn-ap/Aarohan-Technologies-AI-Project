        1568,
        -160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ctx = $('Prepare Employee Context').item.json;\nreturn [{\n  json: {\n    employee_id: ctx.employee_id,\n    employee_name: ctx.employee_name,\n    email_status: 'Sent',\n    calendar_status: 'Created',\n    overall_status: 'Success'\n  }\n}];\n"
