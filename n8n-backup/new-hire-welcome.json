{
  "name": "OnboardAI - New Hire Welcome Engine (Logic)",
  "nodes": [
    {
      "id": "new-hire-onboarding-trigger",
      "name": "New Hire Onboarding Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "employee_id",
              "type": "string"
            },
            {
              "name": "employee_name",
              "type": "string"
            },
            {
              "name": "email",
              "type": "string"
            },
            {
              "name": "isVirtual",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "get-employee-row",
      "name": "Get Employee Row",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        224,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "rE0SYvDEpq8ZDGzR"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "employeeId",
              "condition": "eq",
              "keyValue": "={{ $('New Hire Onboarding Trigger').item.json.employee_id }}"
            }
          ]
        },
        "returnAll": true
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "prepare-employee-context",
      "name": "Prepare Employee Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const trigger = $('New Hire Onboarding Trigger').item.json;\nconst employeeId = trigger.employee_id;\nconst rows = $('Get Employee Row').all().map(i => i.json).filter(r => r.employeeId);\n\nif (rows.length) {\n  const emp = rows[0];\n  const isVirtual = emp.isVirtual === true || emp.isVirtual === 'true' || emp.isVirtual === '1' || emp.isVirtual === 1;\n  return [{\n    json: {\n      employee_id: emp.employeeId,\n      employee_name: emp.employeeName,\n      email: emp.email,\n      isVirtual: isVirtual,\n      found: true\n    }\n  }];\n}\n\n// Not in the pre-seeded Employees Data Table (e.g. an employee created\n// live through the OnboardAI app, which is a separate data store).\n// Fall back to the details passed directly by the caller so the\n// automation still works instead of failing 'Not Found'.\nif (trigger.employee_name && trigger.email) {\n  const isVirtual = trigger.isVirtual === true || trigger.isVirtual === 'true' || trigger.isVirtual === '1' || trigger.isVirtual === 1;\n  return [{\n    json: {\n      employee_id: employeeId,\n      employee_name: trigger.employee_name,\n      email: trigger.email,\n      isVirtual: isVirtual,\n      found: true\n    }\n  }];\n}\n\nreturn [{ json: { employee_id: employeeId, employee_name: null, email: null, isVirtual: null, found: false } }];\n"
      }
    },
    {
      "id": "employee-found",
      "name": "Employee Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        672,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.found }}",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              },
              "rightValue": true
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "send-welcome-email",
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        896,
        -80
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "=Welcome to Aarohan Technologies, {{ $json.employee_name }}!",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:520px;margin:0 auto;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;\"><div style=\"background:linear-gradient(135deg,#1a5fb4,#4c8fdb);padding:24px 28px;text-align:center;\"><img src=\"https://onboarding-ai-ueri.onrender.com/aarohan-logo.webp\" alt=\"Aarohan Technologies\" style=\"height:40px;\" /></div><div style=\"padding:28px;color:#0f172a;\"><p style=\"font-size:15px;line-height:1.6;margin:0 0 14px;\">Hi {{ $json.employee_name }},</p><p style=\"font-size:15px;line-height:1.6;margin:0 0 14px;\">Welcome to Aarohan Technologies! We're excited to have you join us.</p><p style=\"font-size:15px;line-height:1.6;margin:0 0 20px;\">Your onboarding coordinator will reach out shortly with next steps.</p><p style=\"font-size:14px;line-height:1.6;margin:0;color:#334155;\">Best regards,<br>People Operations Team &middot; Aarohan Technologies</p></div></div>",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "REPLACE_ME - Gmail OAuth2"
        }
      }
    },
    {
