    {
      "id": "prepare-employee-context",
      "name": "Prepare Employee Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const trigger = $('New Hire Onboarding Trigger').item.json;\nconst employeeId = trigger.employee_id;\nconst rows = $('Get Employee Row').all().map(i => i.json).filter(r => r.employeeId);\nconst truthy = v => v === true || v === 'true' || v === '1' || v === 1;\nconst esc = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nfunction build(base) {\n  const joining = trigger.joining_date || base.joiningDate || '';\n  let joiningPretty = joining;\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(joining)) {\n    const d = new Date(joining + 'T00:00:00Z');\n    joiningPretty = d.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });\n  }\n  const msg = (trigger.welcome_message || '').trim() || \"We're excited to have you join us. Your onboarding coordinator will reach out shortly with next steps.\";\n  return {\n    employee_id: base.employee_id,\n    employee_name: base.employee_name,\n    email: base.email,\n    isVirtual: base.isVirtual,\n    department: trigger.department || base.department || 'To be confirmed',\n    role_title: trigger.role_title || base.role_title || 'To be confirmed',\n    joining_date: joining,\n    joining_date_pretty: joiningPretty || 'To be confirmed',\n    work_mode: base.isVirtual ? 'Remote / virtual — an orientation invite will be sent to your calendar' : 'Office-based — Pune Headquarters',\n    message_html: msg.split(/\\n\\s*\\n/).map(p => '<p style=\"margin:0 0 14px;\">' + esc(p).replace(/\\n/g, '<br>') + '</p>').join(''),\n    found: true\n  };\n}\n\nif (rows.length) {\n  const emp = rows[0];\n  return [{ json: build({ employee_id: emp.employeeId, employee_name: emp.employeeName, email: emp.email || trigger.email, isVirtual: truthy(emp.isVirtual), joiningDate: emp.joiningDate }) }];\n}\nif (trigger.employee_name && trigger.email) {\n  return [{ json: build({ employee_id: employeeId, employee_name: trigger.employee_name, email: trigger.email, isVirtual: truthy(trigger.isVirtual) }) }];\n}\nreturn [{ json: { employee_id: employeeId, employee_name: null, email: null, isVirtual: null, found: false } }];\n"
      }
    },
