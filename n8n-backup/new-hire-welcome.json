      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.email }}",
        "subject": "=Welcome to Aarohan Technologies, {{ $json.employee_name }}!",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:0 auto;color:#13213d;border:1px solid #dfe6f0;border-radius:10px;overflow:hidden;\"><div style=\"height:6px;background:#1565d8;\"></div><div style=\"padding:28px;\"><h2 style=\"margin:0 0 18px;color:#0d2552;font-size:20px;\">Welcome to Aarohan Technologies, {{ $json.employee_name }}!</h2><p style=\"margin:0 0 14px;font-size:15px;\">Hi {{ $json.employee_name }},</p><div style=\"font-size:15px;line-height:1.6;\">{{ $json.message_html }}</div><table style=\"margin:18px 0;border-collapse:collapse;font-size:14px;width:100%;\"><tr><td style=\"padding:9px 12px;background:#f4f7fb;border:1px solid #dfe6f0;width:38%;\"><b>Department</b></td><td style=\"padding:9px 12px;border:1px solid #dfe6f0;\">{{ $json.department }}</td></tr><tr><td style=\"padding:9px 12px;background:#f4f7fb;border:1px solid #dfe6f0;\"><b>Role</b></td><td style=\"padding:9px 12px;border:1px solid #dfe6f0;\">{{ $json.role_title }}</td></tr><tr><td style=\"padding:9px 12px;background:#f4f7fb;border:1px solid #dfe6f0;\"><b>Joining date</b></td><td style=\"padding:9px 12px;border:1px solid #dfe6f0;\">{{ $json.joining_date_pretty }}</td></tr><tr><td style=\"padding:9px 12px;background:#f4f7fb;border:1px solid #dfe6f0;\"><b>Work mode</b></td><td style=\"padding:9px 12px;border:1px solid #dfe6f0;\">{{ $json.work_mode }}</td></tr></table><p style=\"margin:0;font-size:15px;line-height:1.6;\">If you have any questions before your first day, just reply to this email.</p></div><div style=\"padding:20px 28px;border-top:1px solid #dfe6f0;background:#f9fbfd;\"><p style=\"margin:0 0 12px;font-size:14px;line-height:1.5;\">Warm regards,<br><b>People Operations Team</b><br>Aarohan Technologies</p><img src=\"https://aarohan-onboardai.netlify.app/logo.png\" alt=\"Aarohan Technologies\" style=\"height:46px;\" /></div></div>",
        "options": {
          "appendAttribution": false
        }
      },
