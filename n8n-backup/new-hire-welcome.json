        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $('Prepare Employee Context').item.json.isVirtual }}",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              },
              "rightValue": true
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "create-orientation-event",
      "name": "Create Orientation Event",
      "type": "n8n-nodes-base.googleCalendar",
