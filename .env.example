# Copy to .env for local `netlify dev`, or set these in Netlify > Project configuration > Environment variables.
# NEVER commit real values.

# Required - Groq (only LLM provider). Mark as secret in Netlify.
GROQ_API_KEY=
# Optional - defaults to llama-3.3-70b-versatile
GROQ_MODEL=

# Required - Supabase project (Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional - override n8n MCP endpoints (defaults point at the current n8n cloud instance)
MCP_POLICY_LOOKUP_URL=
MCP_POLICY_INTELLIGENCE_URL=
MCP_ONBOARDING_PROGRESS_URL=
MCP_NEW_HIRE_WELCOME_URL=
# Optional - "Header-Name: value" if you add header auth to the MCP triggers
MCP_AUTH_HEADER=
